(site_auth) {
	basic_auth {
		# Generate hashes with:
		# docker run --rm caddy:2 caddy hash-password --plaintext '<password>'
		{$DASHBOARD_AUTH_USER} {$DASHBOARD_AUTH_PASSWORD_HASH}
		admin {$GRAFANA_ADMIN_PASSWORD_HASH}
	}
}

{$SITE_ADDRESS} {
	tls {$CADDY_TLS}

	# Telemetry ingest — shared bearer token
	@ingest path /v1/logs /v1/metrics
	handle @ingest {
		@authorized header Authorization "Bearer {$INGEST_TOKEN}"
		handle @authorized {
			reverse_proxy collector:4318
		}
		respond "unauthorized" 401
	}

	# Grafana dashboards — shared read-only access
	@dashboard_entry path / /grafana
	redir @dashboard_entry /grafana/ 308

	# Grafana administrator sign-in. The auth proxy header is withheld here, so Grafana
	# serves its own login form instead of signing the request in as a Caddy identity.
	@grafana_admin_login {
		path /grafana/login
		method GET
		query disableAutoLogin=*
	}
	handle @grafana_admin_login {
		import site_auth
		reverse_proxy grafana:3000 {
			header_up -Authorization
			header_up -X-WEBAUTH-USER
		}
	}

	@grafana_login {
		path /grafana/login
		method GET
	}
	handle @grafana_login {
		import site_auth

		@caddy_admin expression `{http.auth.user.id} == "admin"`
		handle @caddy_admin {
			reverse_proxy grafana:3000 {
				header_up -Authorization
				header_up X-WEBAUTH-USER admin
				header_up X-WEBAUTH-ROLE GrafanaAdmin
			}
		}

		handle {
			reverse_proxy grafana:3000 {
				header_up -Authorization
				header_up X-WEBAUTH-USER viewer-{http.auth.user.id}
				header_up X-WEBAUTH-ROLE Viewer
			}
		}
	}

	@grafana_native_login {
		path /grafana/login
		method POST
	}
	handle @grafana_native_login {
		import site_auth
		reverse_proxy grafana:3000 {
			header_up -Authorization
			header_up -X-WEBAUTH-USER
		}
	}

	@grafana path /grafana/*
	handle @grafana {
		reverse_proxy grafana:3000 {
			header_up -Authorization
			header_up -X-WEBAUTH-USER
		}
	}

	# VictoriaLogs UI + query API — shared read-only access
	@vmui path /select/*
	handle @vmui {
		import site_auth
		reverse_proxy victorialogs:9428
	}

	# VictoriaMetrics UI + Prometheus query API — shared read-only access
	@prometheus path \
		/prometheus/api/v1/alerts \
		/prometheus/api/v1/label/* \
		/prometheus/api/v1/labels \
		/prometheus/api/v1/metadata \
		/prometheus/api/v1/query \
		/prometheus/api/v1/query_exemplars \
		/prometheus/api/v1/query_range \
		/prometheus/api/v1/rules \
		/prometheus/api/v1/series \
		/prometheus/api/v1/status/* \
		/prometheus/vmui \
		/prometheus/vmui/*
	handle @prometheus {
		import site_auth
		uri strip_prefix /prometheus
		reverse_proxy victoriametrics:8428
	}

	respond "not found" 404
}
