{$SITE_ADDRESS} {
	tls {$CADDY_TLS}

	# Telemetry ingest — shared bearer token
	@ingest path /v1/logs
	handle @ingest {
		@authorized header Authorization "Bearer {$INGEST_TOKEN}"
		handle @authorized {
			reverse_proxy collector:4318
		}
		respond "unauthorized" 401
	}

	# Grafana dashboards — shared read-only access
	@dashboard_entry path / /grafana
	redir @dashboard_entry /grafana/ 308

	@grafana_login {
		path /grafana/login
		method GET
	}
	handle @grafana_login {
		basic_auth {
			# Generate DASHBOARD_AUTH_PASSWORD_HASH with:
			# docker run --rm caddy:2 caddy hash-password --plaintext '<password>'
			{$DASHBOARD_AUTH_USER} {$DASHBOARD_AUTH_PASSWORD_HASH}
		}
		reverse_proxy grafana:3000 {
			header_up -Authorization
			header_up X-WEBAUTH-USER viewer-{http.auth.user.id}
		}
	}

	@grafana_native_login {
		path /grafana/login
		method POST
	}
	handle @grafana_native_login {
		basic_auth {
			{$DASHBOARD_AUTH_USER} {$DASHBOARD_AUTH_PASSWORD_HASH}
		}
		reverse_proxy grafana:3000 {
			header_up -Authorization
			header_up -X-WEBAUTH-USER
		}
	}

	@grafana path /grafana/*
	handle @grafana {
		reverse_proxy grafana:3000 {
			header_up -Authorization
			header_up -X-WEBAUTH-USER
		}
	}

	# VictoriaLogs UI + query API — shared read-only access
	@vmui path /select/*
	handle @vmui {
		basic_auth {
			{$DASHBOARD_AUTH_USER} {$DASHBOARD_AUTH_PASSWORD_HASH}
		}
		reverse_proxy victorialogs:9428
	}

	respond "not found" 404
}
