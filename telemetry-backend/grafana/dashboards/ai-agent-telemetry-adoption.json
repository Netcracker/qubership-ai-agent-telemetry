   "url": "/grafana/d/ai-agent-health"
  }
 ],
 "panels": [
  {
   "id": 1,
   "type": "text",
   "title": "",
   "transparent": true,
   "gridPos": {
    "h": 2,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "options": {
    "mode": "markdown",
    "content": "> \u26a0\ufe0f **Limitation:** we only see sessions in which at least one skill or MCP tool ran. Sessions with no skill or MCP activity are not visible."
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Active installations per day",
   "gridPos": {
    "h": 4,
    "w": 8,
    "x": 0,
    "y": 2
   },
   "datasource": {
    "type": "victoriametrics-logs-datasource",
    "uid": "victorialogs"
   },
   "fieldConfig": {
    "defaults": {
     "displayName": "Installations",
     "unit": "locale",
     "decimals": 0,
     "min": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "text"
     },
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 0,
      "lineWidth": 1,
      "axisSoftMin": 0
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "victoriametrics-logs-datasource",
      "uid": "victorialogs"
     },
     "expr": "{service.name=\"ai-agent-telemetry\"}\nagent:!=\"selftest\"\nmachine.id:*\nrepo.remote:~\"${repository:regex}\"\nagent:~\"${harness:regex}\"\nos.type:~\"${os:regex}\"\nservice.version:~\"${version:regex}\"\n| stats by (_time:1d offset 0h) count_uniq(machine.id) installations\n| sort by (_time)",
     "queryType": "statsRange",
     "refId": "A"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "hidden",
     "placement": "bottom",
     "showLegend": false
    }
   },
   "description": "UTC calendar-day count of unique machine.id installations that sent telemetry."
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Active repositories per day",
   "gridPos": {
    "h": 4,
    "w": 8,
    "x": 8,
    "y": 2
   },
   "datasource": {
    "type": "victoriametrics-logs-datasource",
    "uid": "victorialogs"
   },
   "fieldConfig": {
    "defaults": {
     "displayName": "Repositories",
     "unit": "locale",
     "decimals": 0,
     "min": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "text"
     },
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 0,
      "lineWidth": 1,
      "axisSoftMin": 0
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "victoriametrics-logs-datasource",
      "uid": "victorialogs"
     },
     "expr": "{service.name=\"ai-agent-telemetry\"}\nagent:!=\"selftest\"\nrepo.remote:*\nrepo.remote:~\"${repository:regex}\"\nagent:~\"${harness:regex}\"\nos.type:~\"${os:regex}\"\nservice.version:~\"${version:regex}\"\n| replace_regexp(`^[[:space:]]+|[[:space:]]+$`, \"\") at repo.remote\n| format \"<lc:repo.remote>\" as repo.remote\n| replace_regexp(`^(git@github[.]com:|ssh://(git@)?github[.]com/|git://github[.]com/|https?://github[.]com/|github[.]com/)`, \"\") at repo.remote\n| replace_regexp(`/+$`, \"\") at repo.remote\n| replace_regexp(`[.]git$`, \"\") at repo.remote\n| replace_regexp(`/+$`, \"\") at repo.remote\n| repo.remote:*\n| stats by (_time:1d offset 0h) count_uniq(repo.remote) repositories\n| sort by (_time)",
     "queryType": "statsRange",
     "refId": "A"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "hidden",
     "placement": "bottom",
     "showLegend": false
    }
   },
   "description": "UTC calendar-day count of normalized repositories, excluding events with missing remotes."
  },
  {
