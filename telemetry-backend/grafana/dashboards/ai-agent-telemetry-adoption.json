   "gridPos": {
    "h": 4,
    "w": 8,
    "x": 16,
    "y": 2
   },
   "datasource": {
    "type": "victoriametrics-logs-datasource",
    "uid": "victorialogs"
   },
   "fieldConfig": {
    "defaults": {
     "displayName": "Sessions",
     "unit": "locale",
     "decimals": 0,
     "min": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "text"
     },
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 0,
      "lineWidth": 1,
      "axisSoftMin": 0
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "victoriametrics-logs-datasource",
      "uid": "victorialogs"
     },
     "expr": "{service.name=\"ai-agent-telemetry\"}\nagent:!=\"selftest\"\nsession.id:*\nrepo.remote:~\"${repository:regex}\"\nagent:~\"${harness:regex}\"\nos.type:~\"${os:regex}\"\nservice.version:~\"${version:regex}\"\n| stats by (_time:1d offset 0h) count_uniq(agent, session.id) sessions\n| sort by (_time)",
     "queryType": "statsRange",
     "refId": "A"
    }
   ],
   "options": {
