   "description": "UTC calendar-day count of unique (agent, session.id) sessions with observed telemetry."
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Telemetry activity",
   "description": "Deduplicated skill executions vs MCP tool calls over time (stacked).",
   "gridPos": {
    "h": 7,
    "w": 24,
    "x": 0,
    "y": 6
   },
   "datasource": {
    "type": "victoriametrics-logs-datasource",
    "uid": "victorialogs"
   },
   "maxDataPoints": 80,
   "fieldConfig": {
    "defaults": {
     "min": 0,
     "unit": "short",
     "color": {
      "mode": "continuous-BlPu"
     },
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 85,
      "lineWidth": 1,
      "barAlignment": 0,
      "barWidthFactor": 0.9,
      "stacking": {
       "mode": "normal",
       "group": "A"
      },
      "axisSoftMin": 0
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Skill events"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#5794F2"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "MCP calls"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#B877D9"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "queryType": "statsRange",
     "step": "$__interval",
     "datasource": {
      "type": "victoriametrics-logs-datasource",
      "uid": "victorialogs"
     },
     "expr": "{service.name=\"ai-agent-telemetry\"} agent:!=\"selftest\" repo.remote:~\"${repository:regex}\" agent:~\"${harness:regex}\" os.type:~\"${os:regex}\" service.version:~\"${version:regex}\" _msg:=\"skill_executed\" | format if (!event.id:*) \"legacy-<_stream_id>-<_time>\" as event.id | stats count_uniq(event.id) \"Skill events\""
    },
    {
     "refId": "B",
     "queryType": "statsRange",
     "step": "$__interval",
     "datasource": {
      "type": "victoriametrics-logs-datasource",
      "uid": "victorialogs"
     },
     "expr": "{service.name=\"ai-agent-telemetry\"} agent:!=\"selftest\" repo.remote:~\"${repository:regex}\" agent:~\"${harness:regex}\" os.type:~\"${os:regex}\" service.version:~\"${version:regex}\" _msg:=\"mcp_tool_executed\" | format if (!event.id:*) \"legacy-<_stream_id>-<_time>\" as event.id | stats count_uniq(event.id) \"MCP calls\""
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Onboarding over time",
   "gridPos": {
    "h": 8,
    "w": 24,
    "x": 0,
    "y": 13
   },
   "datasource": {
    "type": "victoriametrics-logs-datasource",
    "uid": "victorialogs"
   },
   "fieldConfig": {
    "defaults": {
     "min": 0,
     "unit": "short",
     "decimals": 0,
     "custom": {
      "drawStyle": "line",
      "lineInterpolation": "stepAfter",
      "lineWidth": 2,
      "fillOpacity": 15,
      "showPoints": "always",
      "pointSize": 6,
      "spanNulls": true
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Machines"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#5794F2"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Repositories"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#FF9830"
        }
       }
      ]
     }
    ]
   },
   "targets": [
    {
     "datasource": {
      "type": "victoriametrics-logs-datasource",
      "uid": "victorialogs"
     },
     "expr": "{service.name=\"ai-agent-telemetry\"} agent:!=\"selftest\" repo.remote:~\"${repository:regex}\" agent:~\"${harness:regex}\" os.type:~\"${os:regex}\" service.version:~\"${version:regex}\" | stats by (machine.id) min(_time) as _time | stats by (_time:1d) count() machines | sort by (_time)",
     "queryType": "logs",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "victoriametrics-logs-datasource",
      "uid": "victorialogs"
     },
     "expr": "{service.name=\"ai-agent-telemetry\"} agent:!=\"selftest\" repo.remote:~\"${repository:regex}\" agent:~\"${harness:regex}\" os.type:~\"${os:regex}\" service.version:~\"${version:regex}\" | format if (!repo.remote:*) \"(unknown)\" as repo.remote | replace (\"git@github.com:\", \"\") at repo.remote | replace (\"github.com/\", \"\") at repo.remote | replace (\".git\", \"\") at repo.remote | format \"<lc:repo.remote>\" as repo.remote | stats by (repo.remote) min(_time) as _time | stats by (_time:1d) count() repositories | sort by (_time)",
     "queryType": "logs",
     "refId": "B"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "transformations": [
    {
     "id": "extractFields",
     "options": {
      "source": "labels"
     }
    },
    {
     "id": "convertFieldType",
     "options": {
      "conversions": [
       {
        "targetField": "machines",
        "destinationType": "number"
       },
       {
        "targetField": "repositories",
        "destinationType": "number"
       }
      ]
     }
    },
    {
     "id": "calculateField",
     "options": {
      "mode": "cumulativeFunctions",
      "cumulative": {
       "field": "machines",
       "reducer": "sum"
      },
      "alias": "Machines",
      "replaceFields": false
     }
    },
    {
     "id": "calculateField",
     "options": {
      "mode": "cumulativeFunctions",
      "cumulative": {
       "field": "repositories",
       "reducer": "sum"
      },
      "alias": "Repositories",
      "replaceFields": false
     }
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Line": true,
       "labels": true,
       "machines": true,
       "repositories": true
      }
     }
    }
   ],
   "description": "Cumulative count of machines and repositories by the day they first sent telemetry.",
   "timeFrom": "30d"
  },
