{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>Netcracker/renovate-config:base",
    "github>Netcracker/renovate-config:github-actions",
    "github>Netcracker/renovate-config:go",
    "github>Netcracker/renovate-config:netcracker-dependencies",
    "github>Netcracker/renovate-config:go-catch-all",
    "github>Netcracker/renovate-config:annotated-versions",
    "github>Netcracker/renovate-config:grafana-plugins"
  ],
  "timezone": "Europe/Saratov",
  "rangeStrategy": "bump",
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "packageRules": [
    {
      "description": "Group other Docker Compose image non-major updates; exclusions mirror the shared go and netcracker-dependencies presets",
      "matchManagers": [
        "docker-compose"
      ],
      "matchPackageNames": [
        "!ghcr.io/netcracker/**",
        "!golang",
        "!docker.io/library/golang",
        "!index.docker.io/library/golang",
        "!registry-1.docker.io/library/golang"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "Docker Compose image non-major updates"
    },
    {
      "description": "Write an eligible minimum Go minor line as its initial X.Y.0 release",
      "matchManagers": [
        "gomod"
      ],
      "matchDatasources": [
        "golang-version"
      ],
      "matchDepTypes": [
        "golang"
      ],
      "allowedVersions": "/^\\d+\\.\\d+\\.0$/",
      "rangeStrategy": "bump"
    },
    {
      "description": "Update the minimum Go minor line after a five-year adoption period",
      "matchManagers": [
        "gomod"
      ],
      "matchDatasources": [
        "golang-version"
      ],
      "matchDepTypes": [
        "golang"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "minimumReleaseAge": "5 years"
    },
    {
      "description": "Do not update the minimum Go version for patch releases",
      "matchManagers": [
        "gomod"
      ],
      "matchDatasources": [
        "golang-version"
      ],
      "matchDepTypes": [
        "golang"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "enabled": false
    }
  ]
}
